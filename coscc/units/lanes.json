{
  "params": {
    "ci_poll_seconds": 60
  },
  "lanes": {
    "full": {
      "path": [
        { "stage": "idea",   "when": "always" },
        { "stage": "intent", "when": "always" },
        { "stage": "spec",   "when": "unless-skipped" },
        { "stage": "spike",  "when": "if-unmeasured" },
        { "stage": "plan",   "when": "unless-skipped" },
        { "stage": "impl",   "when": "always" },
        { "stage": "review", "when": "always" }
      ],
      "end": "shipped",
      "guards": {
        "unit": {
          "create": "unit-created",
          "result": "stage-result",
          "round": "review-round",
          "claim": "impl-claim",
          "incomplete": "incomplete-round",
          "skip": "skip-decision",
          "plan": "spike-holds",
          "impl": "dependency-merged",
          "ship": "ship-ready"
        },
        "run": {
          "submitted": "run-submitted"
        },
        "pr": {
          "open": "branch-named",
          "ci": "ci-at-head",
          "merge-requested": "ship-ready",
          "merged": "merge-read",
          "closed": "close-read"
        }
      }
    }
  }
}
